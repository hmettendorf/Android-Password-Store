<!--
  android:allowBackup="false" stops cloud backup, but on Android 12 and above it does NOT stop
  device-to-device transfer: that is governed by this file alone. Without these exclusions a
  transfer copies the PGP secret keys under files/pgp_keys and the SSH private key at
  files/.ssh_key onto the new device, where the Keystore keys that protect them do not exist.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
